## ============================================================
## CTL_widget_inst-detail
## dotCMS widget variable: CtlWidgetInstDetail
## Renders a single CtlInstructionalResource record.
## Matches the URL slug (last path segment) against urlTitle —
## CtlInstructionalResource has no urlMapPattern field, so this
## mirrors CTL_widget_activity-detail's pull-all + Velocity-side
## slug match instead of relying on native URL Map resolution.
## Requires: content type's URL Map Pattern set to
##   /centers/ctl/instructional-resources/{urlTitle}
## Detail Page: "Instructional Resource Detail"
##   (/centers/ctl/instructional-resources/instructional-resource-detail)
## ============================================================

#set($forwardUri = $request.getAttribute("javax.servlet.forward.request_uri"))
#if("$!forwardUri" != "")
    #set($uri = $forwardUri)
#else
    #set($uri = $request.getRequestURI())
#end

#set($idx = $uri.lastIndexOf('/'))
#set($idxPlus = $idx.intValue() + 1)
#set($slug = $uri.substring($idxPlus))

#set($matchList = [])

#if($slug == "" || $slug == "instructional-resources" || $slug == "instructional-resource-detail" || $slug == "index" || $slug == "index.dot")
    <div style="background: #fff3cd; color: #856404; padding: 20px; border: 1px solid #ffeeba; border-radius: 6px;">
        <h4 style="margin-top: 0;">🛠️ Editor System Template View</h4>
        <p>No resource slug detected. To preview, publish this page and click a card from the Instructional Resources listing.</p>
    </div>
#else
    #set($allResources = $dotcontent.pull("+contentType:CtlInstructionalResource +languageId:1 +live:true", 500, "score"))
    #foreach($r in $allResources)
        #if("$!r.urlTitle" == $slug)
            #set($dummy = $matchList.add($r))
        #end
    #end

    #if($matchList.size() > 0)
        #set($item = $matchList.get(0))

        ## --- format / topics / frameworks: Category fields, read .categoryName ---
        #set($fmtStr = "")
        #if($item.formatType && $item.formatType.size() > 0)
            #foreach($c in $item.formatType)
                #if($fmtStr == "")#set($fmtStr = "$!c.categoryName")#else#set($fmtStr = "$fmtStr|$!c.categoryName")#end
            #end
        #end

        #set($topicsList = [])
        #if($item.topics && $item.topics.size() > 0)
            #foreach($c in $item.topics)
                #if("$!c.categoryName" != "")
                    #set($dummy2 = $topicsList.add($c.categoryName))
                #end
            #end
        #end

        #set($frameworksList = [])
        #if($item.frameworks && $item.frameworks.size() > 0)
            #foreach($c in $item.frameworks)
                #if("$!c.categoryName" != "")
                    #set($dummy3 = $frameworksList.add($c.categoryName))
                #end
            #end
        #end

        ## --- modality: Checkbox field -> selectedValues, mapped to display labels ---
        #set($modStr = "")
        #if($item.modality && $item.modality.selectedValues && $item.modality.selectedValues.size() > 0)
            #foreach($sv in $item.modality.selectedValues)
                #set($label = $sv)
                #set($midx = 0)
                #foreach($v in $item.modality.values)
                    #if("$v" == "$sv")
                        #set($label = $item.modality.options.get($midx))
                    #end
                    #set($midx = $midx + 1)
                #end
                #if($modStr == "")#set($modStr = "$label")#else#set($modStr = "$modStr|$label")#end
            #end
        #end

        <style>
            .ctl-ir-tag { display: inline-flex; align-items: center; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; padding: 4px 8px; background-color: #f4f4f4; color: #444; border: 1px solid #ddd; border-radius: 4px; margin-right: 6px; margin-bottom: 6px; }
            .ctl-ir-topic-chip { display: inline-block; font-size: 0.75rem; padding: 3px 10px; background: #fff; color: #666; border: 1px solid #ccc; border-radius: 20px; margin-right: 6px; margin-bottom: 6px; }
            .ctl-ir-framework-chip { display: inline-block; font-size: 0.75rem; padding: 3px 10px; background: #f0ece9; color: #730A00; border: 1px solid #e0d6d2; border-radius: 20px; margin-right: 6px; margin-bottom: 6px; }
            .ctl-ir-byline { font-size: 0.9rem; color: #666; margin-bottom: 24px; }
            .ctl-ir-btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; white-space: nowrap; padding: 6px 16px; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; line-height: 1.2; color: #730A00; background: transparent; border: 1px solid #730A00; border-radius: 4px; text-decoration: none; }
            .ctl-ir-btn:hover { background: #730A00; color: #fff; text-decoration: none; }
            .ctl-ir-related-card .card-title a { color: inherit; text-decoration: none; }
            .ctl-ir-related-card .card-title a:hover { color: #730A00; text-decoration: underline; }
        </style>

        <article style="max-width: 860px;">

            #if("$!item.thumbnail.fileName" != "")
                <img src="$item.thumbnail.path$item.thumbnail.fileName" alt="$item.resourceTitle" style="width: 100%; max-height: 360px; object-fit: cover; border-radius: 8px; margin-bottom: 24px;" />
            #end

            #if($fmtStr != "" || $modStr != "")
                <div style="margin-bottom: 10px;">
                    #foreach($f in $fmtStr.split("\|"))
                        #if($f != "")<span class="ctl-ir-tag">$f</span>#end
                    #end
                    #foreach($m in $modStr.split("\|"))
                        #if($m != "")<span class="ctl-ir-tag">$m</span>#end
                    #end
                </div>
            #end

            <h1 style="margin-top: 0;">$item.resourceTitle</h1>

            <p class="ctl-ir-byline">
                #if("$!item.author" != "")By $item.author#end
                #if("$!item.lastUpdated" != "")#if("$!item.author" != "") &middot; #end Updated $date.format('MMMM d, yyyy', $item.lastUpdated)#end
            </p>

            #if(!$frameworksList.isEmpty())
                <div style="margin-bottom: 20px;">
                    #foreach($fw in $frameworksList)
                        <span class="ctl-ir-framework-chip">$fw</span>
                    #end
                </div>
            #end

            ## --- video: local upload (File field) takes precedence over an embed URL ---
            #if("$!item.videoFile.rawUri" != "")
                <div style="margin-bottom: 28px;">
                    <video controls style="width: 100%; border-radius: 8px;" src="$item.videoFile.rawUri"></video>
                </div>
            #elseif("$!item.embedUrl" != "")
                <div style="margin-bottom: 28px;">
                    <a href="$item.embedUrl" target="_blank" rel="noopener" class="ctl-ir-btn">
                        <i class="bi bi-play-circle"></i> Watch Video
                    </a>
                </div>
            #end

            #if("$!item.shortDescription" != "")
                <p style="font-size: 1.1rem; color: #444; margin-bottom: 24px;">$item.shortDescription</p>
            #end

            #if("$!item.body" != "")
                <div style="line-height: 1.7; font-size: 1rem; color: #333; margin-bottom: 28px;">$item.body</div>
            #end

            #if(!$topicsList.isEmpty())
                <div style="margin-bottom: 28px; border-top: 1px solid #e0e0e0; padding-top: 20px;">
                    <h3 style="font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.5px; color: #730A00; margin-bottom: 10px;">Topics</h3>
                    #foreach($tp in $topicsList)
                        <span class="ctl-ir-topic-chip">$tp</span>
                    #end
                </div>
            #end

            #if("$!item.citations" != "")
                <div style="margin-bottom: 28px; border-top: 1px solid #e0e0e0; padding-top: 20px;">
                    <h3 style="font-size: 1.1rem; margin-bottom: 12px; font-weight: 700;">Citations &amp; Further Reading</h3>
                    <div style="font-size: 0.9rem; color: #444; line-height: 1.6;">$item.citations</div>
                </div>
            #end

            #if($item.relatedInstructionalResources && $item.relatedInstructionalResources.size() > 0)
                <div style="margin-bottom: 32px; border-top: 1px solid #e0e0e0; padding-top: 20px;">
                    <h3 style="font-size: 1.1rem; margin-bottom: 16px; font-weight: 700;">Related Resources</h3>
                    <div class="row row-cols-1 row-cols-md-2 g-3">
                        #foreach($rel in $item.relatedInstructionalResources)
                            <div class="col">
                                <div class="card h-100 ctl-ir-related-card">
                                    <div class="card-body">
                                        <h4 class="h6 card-title">
                                            <a href="/centers/ctl/instructional-resources/$!rel.urlTitle">$!rel.resourceTitle</a>
                                        </h4>
                                        #if("$!rel.shortDescription" != "")
                                            <p class="card-text small">$rel.shortDescription</p>
                                        #end
                                    </div>
                                </div>
                            </div>
                        #end
                    </div>
                </div>
            #end

            #if($item.relatedEvents && $item.relatedEvents.size() > 0)
                <div style="margin-bottom: 32px; border-top: 1px solid #e0e0e0; padding-top: 20px;">
                    <h3 style="font-size: 1.1rem; margin-bottom: 16px; font-weight: 700;">Related Events &amp; Opportunities</h3>
                    <ul style="padding-left: 20px;">
                        #foreach($rel in $item.relatedEvents)
                            <li><a href="/centers/ctl/activities/$!rel.urlMapPattern">$!rel.title</a></li>
                        #end
                    </ul>
                </div>
            #end

            <p style="margin-top: 40px;">
                <a href="/centers/ctl/instructional-resources" style="color: inherit;">&larr; Back to Instructional Resources</a>
            </p>

        </article>

    #else
        <div style="padding: 40px; text-align: center; color: #666;">
            <h2>Not Found</h2>
            <p>Sorry, this resource could not be found or may have been removed.</p>
            <a href="/centers/ctl/instructional-resources" style="color: inherit;">Return to Instructional Resources</a>
        </div>
    #end
#end

#if($matchList.size() > 0)
<script>
document.addEventListener('DOMContentLoaded', function() {
    var titleBanner = document.querySelector('.page-title h1');
    if (titleBanner) {
        titleBanner.textContent = '$item.resourceTitle';
    }
    document.title = '$item.resourceTitle';

    var crumbs = document.querySelectorAll('ol.breadcrumb li.breadcrumb-item');
    if (crumbs.length >= 2) {
        var parentCrumb = crumbs[crumbs.length - 2];
        var activeCrumb = crumbs[crumbs.length - 1];

        var parentLink = parentCrumb.querySelector('a');
        if (parentLink) {
            parentLink.setAttribute('href', '/centers/ctl/instructional-resources');
            parentLink.textContent = 'Instructional Resources';
        } else {
            parentCrumb.textContent = 'Instructional Resources';
        }

        activeCrumb.textContent = '$item.resourceTitle';
    }
});
</script>
#end
