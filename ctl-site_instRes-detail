## ============================================================
## CTL_widget_instructional-resources_listing  (v2)
## Fixes from debug session:
##  - modality is a Checkbox field -> .selectedValues, mapped to labels
##  - featured is a Radio -> .selectValue only
##  - zero-visible-resources is now LOUD, not a silent blank page
##  - edit-mode notice shows how many items the reviewedBy gate hid
## ============================================================

#set($allResources = $dotcontent.pull("+contentType:CtlInstructionalResource +languageId:1 +live:true", 500, "score"))

## ---- QC gate: only reviewed items appear ----
#set($visibleResources = [])
#set($hiddenCount = 0)
#foreach($r in $allResources)
    #if("$!r.reviewedBy" != "")
        #set($dummy = $visibleResources.add($r))
    #else
        #set($hiddenCount = $hiddenCount + 1)
    #end
#end

#if($EDIT_MODE && $hiddenCount > 0)
    <div style="background: #fff3cd; color: #856404; border: 1px solid #ffeeba; border-radius: 6px; padding: 10px 14px; margin-bottom: 16px; font-size: 0.9rem;">
        &#128736;&#65039; <strong>Editors only:</strong> $hiddenCount item(s) hidden from this listing because "Reviewed By" is empty.
    </div>
#end

<style>
    .ctl-res-card { position: relative; }
    .ctl-res-card.is-featured { border: 2px solid #730A00; }
    .ctl-res-featured-flag { position: absolute; top: 10px; right: 10px; background: #730A00; color: #fff; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; padding: 3px 8px; border-radius: 4px; z-index: 2; }
    .ctl-res-topic-group { margin-bottom: 10px; }
    .ctl-res-topic-group-heading { display: block; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #730A00; margin-bottom: 2px; }
    .ctl-res-filterbar { margin-bottom: 24px; }
    .ctl-res-filter-group { margin-bottom: 10px; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
    .ctl-res-filter-group .ctl-res-filter-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #666; min-width: 80px; }
    .ctl-res-pill { font-size: 0.8rem; padding: 4px 12px; border: 1px solid #ccc; border-radius: 20px; background: #fff; color: #444; cursor: pointer; }
    .ctl-res-pill:hover { border-color: #730A00; color: #730A00; }
    .ctl-res-pill.active { background: #730A00; border-color: #730A00; color: #fff; }
    .ctl-res-fmt-badge { display: inline-block; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; padding: 3px 8px; background: #f4f4f4; color: #444; border: 1px solid #ddd; border-radius: 4px; margin-right: 4px; margin-bottom: 6px; }
    .ctl-res-topic-chip { display: inline-block; font-size: 0.7rem; padding: 2px 9px; background: #fff; color: #666; border: 1px solid #ccc; border-radius: 20px; margin-right: 4px; margin-top: 4px; }
    .ctl-res-card .card-title a { color: inherit; text-decoration: none; }
    .ctl-res-card .card-title a:hover { color: #730A00; text-decoration: underline; }
    .ctl-res-card img.ctl-res-thumb { width: 100%; height: 160px; object-fit: cover; }
    .ctl-res-count { font-size: 0.85rem; color: #666; margin-bottom: 12px; }
</style>

<div class="ctl-res-listing">

#if($visibleResources.size() == 0)

    <div style="padding: 40px; text-align: center; color: #666;">
        <p>Resources are coming soon &mdash; check back shortly.</p>
    </div>

#else

    ## ---- Filter bar (options built by JS from the actual cards) ----
    <div class="ctl-res-filterbar" id="ctlResFilterBar" style="display:none;">
        <div class="ctl-res-filter-group">
            <input type="text" class="form-control form-control-sm" id="ctlResSearch"
                   placeholder="Search resources&hellip;" style="max-width: 320px;" />
        </div>
        <div class="ctl-res-filter-group" id="ctlResFilterFormat">
            <span class="ctl-res-filter-label">Format</span>
        </div>
        <div class="ctl-res-filter-group" id="ctlResFilterModality">
            <span class="ctl-res-filter-label">Modality</span>
        </div>
        <div class="ctl-res-filter-group" id="ctlResFilterTopic">
            <span class="ctl-res-filter-label">Topics</span>
            <button type="button" class="ctl-res-pill" id="ctlResTopicToggle">Choose topics &#9662;</button>
        </div>
        <div id="ctlResTopicCloud" style="display:none; padding: 10px 12px; margin: 0 0 10px 80px; border: 1px solid #e0e0e0; border-radius: 8px; background: #fafafa;"></div>
    </div>

    <p class="ctl-res-count" id="ctlResCount"></p>

    ## ---- The cards ----
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="ctlResGrid">
        #foreach($r in $visibleResources)

            ## --- format / category / topics: pipe-joined category names ---
            #set($fmtStr = "")
            #if($r.formatType && $r.formatType.size() > 0)
                #foreach($c in $r.formatType)
                    #if($fmtStr == "")#set($fmtStr = "$!c.categoryName")#else#set($fmtStr = "$fmtStr|$!c.categoryName")#end
                #end
            #end

            #set($topicStr = "")
            #if($r.topics && $r.topics.size() > 0)
                #foreach($c in $r.topics)
                    #if($topicStr == "")#set($topicStr = "$!c.categoryName")#else#set($topicStr = "$topicStr|$!c.categoryName")#end
                #end
            #end

            ## --- modality: Checkbox field -> selectedValues, mapped to display labels ---
            #set($modStr = "")
            #if($r.modality && $r.modality.selectedValues && $r.modality.selectedValues.size() > 0)
                #foreach($sv in $r.modality.selectedValues)
                    #set($label = $sv)
                    #set($idx = 0)
                    #foreach($v in $r.modality.values)
                        #if("$v" == "$sv")
                            #set($label = $r.modality.options.get($idx))
                        #end
                        #set($idx = $idx + 1)
                    #end
                    #if($modStr == "")#set($modStr = "$label")#else#set($modStr = "$modStr|$label")#end
                #end
            #end

            #set($updatedMs = 0)
            #if("$!r.lastUpdated" != "")
                #set($updatedMs = $r.lastUpdated.getTime())
            #end
            #set($modDateMs = 0)
            #if("$!r.modDate" != "")
                #set($modDateMs = $r.modDate.getTime())
            #end

            #set($isFeatured = "no")
            #if("$!r.featured.selectValue" == "yes")
                #set($isFeatured = "yes")
            #end

            #set($cardDesc = "$!r.shortDescription")

            <div class="col ctl-res-card-wrap"
                 data-format="$fmtStr"
                 data-modality="$modStr"
                 data-topics="$topicStr"
                 data-featured="$isFeatured"
                 data-updated="$updatedMs"
                 data-moddate="$modDateMs">
                <div class="card h-100 ctl-res-card">
                    #if("$!r.thumbnail.fileName" != "")
                        <img src="$r.thumbnail.path$r.thumbnail.fileName" alt="" class="ctl-res-thumb card-img-top" />
                    #end
                    <div class="card-body">
                        <div>
                            #foreach($f in $fmtStr.split("\|"))
                                #if($f != "")<span class="ctl-res-fmt-badge">$f</span>#end
                            #end
                        </div>
                        <h3 class="h5 card-title">
                            <a href="/centers/ctl/instructional-resources/$!r.urlTitle">$!r.resourceTitle</a>
                        </h3>
                        #if($cardDesc != "")
                            <p class="card-text small">$cardDesc</p>
                        #end
                        #if($topicStr != "")
                            <div>
                                #foreach($tp in $topicStr.split("\|"))
                                    #if($tp != "")<span class="ctl-res-topic-chip">$tp</span>#end
                                #end
                            </div>
                        #end
                    </div>
                </div>
            </div>
        #end
    </div>

    <div id="ctlResEmpty" style="display:none; padding: 40px; text-align: center; color: #666;">
        <p>No resources match your filters.</p>
        <button type="button" class="ctl-res-pill" id="ctlResClear">Clear all filters</button>
    </div>

#end
</div>

#if($visibleResources.size() > 0)
<script>
document.addEventListener('DOMContentLoaded', function() {
    var grid = document.getElementById('ctlResGrid');
    var cards = Array.prototype.slice.call(grid.querySelectorAll('.ctl-res-card-wrap'));

    var countEl = document.getElementById('ctlResCount');
    var emptyEl = document.getElementById('ctlResEmpty');
    // ---- topic schema: parent categories and their child topics ----
    // Keep in sync with the dotCMS category tree. Topics found on cards but not
    // listed here fall into a "More Topics" group, so new topics still filter.
    var TOPIC_SCHEMA = [
        { parent: 'Course Policies, Norms, & Expectations', children: ['Attendance', 'Grade Scheme', 'Expectations for Participation', 'Assignments', 'Student Access to Materials', 'Student Wellbeing', 'Academic Integrity', 'Communication'] },
        { parent: 'Curriculum Design', children: ['Content + Sequencing', 'Learning Objectives', 'Course Planning / Schedule'] },
        { parent: 'Student Engagement', children: ['Peer Collaboration', 'Interactive Tech', 'Activity Design'] },
        { parent: 'Assessment & Grading', children: ['Formative Assessment', 'Summative Assessment', 'Rubric Design', 'Giving Feedback', 'Grading', 'Resubmission'] },
        { parent: 'Course Materials & Tooling', children: ['Title II Remediation', 'OER', 'Selecting Readings / Textbooks', 'Lectures + Slides', 'AI Use'] },
        { parent: 'Classroom Climate & Student Voice', children: ['Course Evals', 'Feedback Systems', 'Inclusive Instruction', 'Intellectual Respect', 'A Culture of Care'] }
    ];
    var PARENT_NAMES = {};
    TOPIC_SCHEMA.forEach(function(g) { PARENT_NAMES[g.parent] = true; });

    // ---- prune parent-category chips from cards (child topics only on tiles) ----
    grid.querySelectorAll('.ctl-res-topic-chip').forEach(function(ch) {
        if (PARENT_NAMES[ch.textContent.trim()]) { ch.parentNode.removeChild(ch); }
    });

    // ---- featured: top 3 by modDate get pinned + badged, but filter like any card ----
    var MAX_FEATURED = 3;
    var featured = cards.filter(function(c) { return c.getAttribute('data-featured') === 'yes'; });
    featured.sort(function(a, b) {
        return Number(b.getAttribute('data-moddate')) - Number(a.getAttribute('data-moddate'));
    });
    featured.slice(0, MAX_FEATURED).forEach(function(c) {
        c.setAttribute('data-pinned', '1');
        var inner = c.querySelector('.ctl-res-card');
        if (inner) {
            inner.classList.add('is-featured');
            var flag = document.createElement('span');
            flag.className = 'ctl-res-featured-flag';
            flag.textContent = '\u2605 Featured';
            inner.appendChild(flag);
        }
    });

    // ---- default sort: pinned featured first, then lastUpdated desc ----
    cards.sort(function(a, b) {
        var pa = a.getAttribute('data-pinned') === '1' ? 0 : 1;
        var pb = b.getAttribute('data-pinned') === '1' ? 0 : 1;
        if (pa !== pb) { return pa - pb; }
        return Number(b.getAttribute('data-updated')) - Number(a.getAttribute('data-updated'));
    });
    cards.forEach(function(c) { grid.appendChild(c); });

    // ---- 3. build filter options from the cards themselves ----
    function collectValues(attr) {
        var seen = {};
        var out = [];
        cards.forEach(function(c) {
            var raw = c.getAttribute(attr) || '';
            raw.split('|').forEach(function(v) {
                v = v.trim();
                if (v !== '' && !seen[v]) { seen[v] = true; out.push(v); }
            });
        });
        out.sort();
        return out;
    }

    var state = { format: '', modality: '', topics: [], search: '' };

    function buildPills(containerId, attr, stateKey) {
        var container = document.getElementById(containerId);
        var values = collectValues(attr);
        if (values.length === 0) { container.style.display = 'none'; return; }
        values.forEach(function(v) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'ctl-res-pill';
            btn.textContent = v;
            btn.setAttribute('data-value', v);
            btn.addEventListener('click', function() {
                var isActive = btn.classList.contains('active');
                container.querySelectorAll('.ctl-res-pill').forEach(function(p) { p.classList.remove('active'); });
                state[stateKey] = isActive ? '' : v;
                if (!isActive) { btn.classList.add('active'); }
                applyFilters();
            });
            container.appendChild(btn);
        });
    }

    buildPills('ctlResFilterFormat', 'data-format', 'format');
    buildPills('ctlResFilterModality', 'data-modality', 'modality');

    var topicCloud = document.getElementById('ctlResTopicCloud');
    var topicToggle = document.getElementById('ctlResTopicToggle');
    var topicValues = collectValues('data-topics');
    if (topicValues.length === 0) {
        document.getElementById('ctlResFilterTopic').style.display = 'none';
    } else {
        var presentTopics = {};
        topicValues.forEach(function(v) { presentTopics[v] = true; });

        function makeTopicPill(v) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'ctl-res-pill';
            btn.style.margin = '3px';
            btn.textContent = v;
            btn.addEventListener('click', function() {
                var i = state.topics.indexOf(v);
                if (i === -1) {
                    state.topics.push(v);
                    btn.classList.add('active');
                } else {
                    state.topics.splice(i, 1);
                    btn.classList.remove('active');
                }
                updateTopicToggleLabel();
                applyFilters();
            });
            return btn;
        }

        function addTopicGroup(heading, names) {
            if (names.length === 0) { return; }
            var group = document.createElement('div');
            group.className = 'ctl-res-topic-group';
            var h = document.createElement('span');
            h.className = 'ctl-res-topic-group-heading';
            h.textContent = heading;
            group.appendChild(h);
            names.forEach(function(v) { group.appendChild(makeTopicPill(v)); });
            topicCloud.appendChild(group);
        }

        var placed = {};
        TOPIC_SCHEMA.forEach(function(g) {
            var here = g.children.filter(function(name) { return presentTopics[name]; });
            here.forEach(function(name) { placed[name] = true; });
            addTopicGroup(g.parent, here);
        });
        // anything on cards that isn't in the schema (and isn't a parent name)
        var leftovers = topicValues.filter(function(v) { return !placed[v] && !PARENT_NAMES[v]; });
        addTopicGroup('More Topics', leftovers);
        topicToggle.addEventListener('click', function() {
            var isOpen = topicCloud.style.display !== 'none';
            topicCloud.style.display = isOpen ? 'none' : '';
            updateTopicToggleLabel();
        });
    }

    function updateTopicToggleLabel() {
        var n = state.topics.length;
        var isOpen = topicCloud.style.display !== 'none';
        var arrow = isOpen ? ' \u25B4' : ' \u25BE';
        topicToggle.textContent = (n === 0 ? 'Choose topics' : n + ' topic' + (n === 1 ? '' : 's') + ' selected') + arrow;
        if (n > 0) { topicToggle.classList.add('active'); } else { topicToggle.classList.remove('active'); }
    }

    var searchBox = document.getElementById('ctlResSearch');
    searchBox.addEventListener('input', function() {
        state.search = searchBox.value.toLowerCase().trim();
        applyFilters();
    });

    document.getElementById('ctlResFilterBar').style.display = '';

    // ---- 4. filtering ----
    function attrHas(card, attr, value) {
        if (value === '') { return true; }
        var raw = card.getAttribute(attr) || '';
        var parts = raw.split('|');
        for (var i = 0; i < parts.length; i++) {
            if (parts[i].trim() === value) { return true; }
        }
        return false;
    }

    function topicsMatch(card) {
        if (state.topics.length === 0) { return true; }
        // match-ANY: card passes if it has at least one selected topic.
        // For match-ALL (narrowing) semantics, change .some to .every below.
        return state.topics.some(function(t) { return attrHas(card, 'data-topics', t); });
    }

    function applyFilters() {
        var shown = 0;
        cards.forEach(function(c) {
            var ok = attrHas(c, 'data-format', state.format) &&
                     attrHas(c, 'data-modality', state.modality) &&
                     topicsMatch(c);
            if (ok && state.search !== '') {
                ok = c.textContent.toLowerCase().indexOf(state.search) !== -1;
            }
            c.style.display = ok ? '' : 'none';
            if (ok) { shown++; }
        });
        emptyEl.style.display = (shown === 0) ? '' : 'none';
        countEl.textContent = 'Showing ' + shown + ' of ' + cards.length + ' resources';
    }

    document.getElementById('ctlResClear').addEventListener('click', function() {
        state = { format: '', modality: '', topics: [], search: '' };
        searchBox.value = '';
        document.querySelectorAll('.ctl-res-pill.active').forEach(function(p) { p.classList.remove('active'); });
        if (topicValues.length > 0) { updateTopicToggleLabel(); }
        applyFilters();
    });

    applyFilters();
});
</script>
#end
