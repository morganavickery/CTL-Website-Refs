#if($matchList.size() > 0)
<script>
document.addEventListener('DOMContentLoaded', function() {
    ## Read the title from a data attribute on <article> rather than embedding it
    ## in a JS string literal -- an apostrophe in the title would otherwise break
    ## out of the string and throw, silently killing this whole script block.
    var resourceTitle = document.querySelector('article[data-resource-title]');
    resourceTitle = resourceTitle ? resourceTitle.getAttribute('data-resource-title') : '';

    var titleBanner = document.querySelector('.page-title h1');
    if (titleBanner && resourceTitle) {
        titleBanner.textContent = resourceTitle;
    }
    if (resourceTitle) {
        document.title = resourceTitle;
    }

    var crumbs = document.querySelectorAll('ol.breadcrumb li.breadcrumb-item');
    if (crumbs.length >= 2) {
        var parentCrumb = crumbs[crumbs.length - 2];
        var activeCrumb = crumbs[crumbs.length - 1];

        var parentLink = parentCrumb.querySelector('a');
        if (parentLink) {
            parentLink.setAttribute('href', '/centers/ctl/resources/instructional-design-resources');
            parentLink.textContent = 'Instructional Design Resources';
        } else {
            parentCrumb.textContent = 'Instructional Design Resources';
        }

        // Resource titles can run long, so the trail stops at "Instructional
        // Design Resources" instead of showing the article's own name.
        activeCrumb.remove();
    }
});
</script>
#end
