## ============================================================
## Resources > For Course Design — single CtlInstructionalResource detail page.
## dotCMS widget variable: CtlWidgetInstDetail
## Matches the URL slug (last path segment) against urlTitle via pull-all +
## Velocity-side filter (no native urlMapPattern field on this content type).
## URL Map Pattern: /centers/ctl/resources/course-design/{urlTitle}
## ============================================================

#set($forwardUri = $request.getAttribute("javax.servlet.forward.request_uri"))
#if("$!forwardUri" != "")
    #set($uri = $forwardUri)
#else
    #set($uri = $request.getRequestURI())
#end

#set($idx = $uri.lastIndexOf('/'))
#set($idxPlus = $idx.intValue() + 1)
#set($slug = $uri.substring($idxPlus))

#set($matchList = [])

#if($slug == "" || $slug == "course-design" || $slug == "resources" || $slug == "instructional-resource-detail" || $slug == "index" || $slug == "index.dot")
    <div style="background: #fff3cd; color: #856404; padding: 20px; border: 1px solid #ffeeba; border-radius: 6px;">
        <h4 style="margin-top: 0;">🛠️ Editor System Template View</h4>
        <p>No resource slug detected. To preview, publish this page and click a card from the For Course Design listing.</p>
    </div>
#else
    #set($allResources = $dotcontent.pull("+contentType:CtlInstructionalResource +languageId:1 +live:true", 500, "score"))
    #foreach($r in $allResources)
        #if("$!r.urlTitle" == $slug)
            #set($dummy = $matchList.add($r))
        #end
    #end

    #if($matchList.size() > 0)
        #set($item = $matchList.get(0))

        ## --- format / topics / frameworks: Category fields, read .categoryName ---
        #set($fmtStr = "")
        #if($item.formatType && $item.formatType.size() > 0)
            #foreach($c in $item.formatType)
                #if($fmtStr == "")#set($fmtStr = "$!c.categoryName")#else#set($fmtStr = "$fmtStr|$!c.categoryName")#end
            #end
        #end

        #set($topicsList = [])
        #if($item.topics && $item.topics.size() > 0)
            #foreach($c in $item.topics)
                #if("$!c.categoryName" != "")
                    #set($dummy2 = $topicsList.add($c.categoryName))
                #end
            #end
        #end

        #set($frameworksList = [])
        #if($item.frameworks && $item.frameworks.size() > 0)
            #foreach($c in $item.frameworks)
                #if("$!c.categoryName" != "")
                    #set($dummy3 = $frameworksList.add($c.categoryName))
                #end
            #end
        #end

        ## --- modality: Checkbox field -> selectedValues, mapped to display labels ---
        ## All 3 possible modality values (inperson/async/sync) selected at once collapses
        ## to a single "All Modalities" tag instead of listing all 3 redundantly.
        #set($modStr = "")
        #set($modCount = 0)
        #if($item.modality && $item.modality.selectedValues && $item.modality.selectedValues.size() > 0)
            #set($modCount = $item.modality.selectedValues.size())
            #foreach($sv in $item.modality.selectedValues)
                #set($label = $sv)
                #set($midx = 0)
                #foreach($v in $item.modality.values)
                    #if("$v" == "$sv")
                        #set($label = $item.modality.options.get($midx))
                    #end
                    #set($midx = $midx + 1)
                #end
                #if($modStr == "")#set($modStr = "$label")#else#set($modStr = "$modStr|$label")#end
            #end
        #end
        #set($modAllSelected = $modCount >= 3)

        ## --- body/citations: downgrade any H1/H2 in WYSIWYG content to H3 so editor-typed
        ## headings can't clash with the page's own H1/H2 (accessibility/screenreader hazard) ---
        #set($bodyHtml = "$!item.body")
        #if($bodyHtml != "")
            #set($bodyHtml = $bodyHtml.replaceAll("(?i)<h1([^>]*)>", "<h3$1>"))
            #set($bodyHtml = $bodyHtml.replaceAll("(?i)</h1>", "</h3>"))
            #set($bodyHtml = $bodyHtml.replaceAll("(?i)<h2([^>]*)>", "<h3$1>"))
            #set($bodyHtml = $bodyHtml.replaceAll("(?i)</h2>", "</h3>"))
        #end

        #set($citationsHtml = "$!item.citations")
        #if($citationsHtml != "")
            #set($citationsHtml = $citationsHtml.replaceAll("(?i)<h1([^>]*)>", "<h3$1>"))
            #set($citationsHtml = $citationsHtml.replaceAll("(?i)</h1>", "</h3>"))
            #set($citationsHtml = $citationsHtml.replaceAll("(?i)<h2([^>]*)>", "<h3$1>"))
            #set($citationsHtml = $citationsHtml.replaceAll("(?i)</h2>", "</h3>"))
        #end

        ## --- highlights: Textarea, one bullet per line, capped at 4 ---
        #set($highlightsList = [])
        #set($rawHighlights = "$!item.highlights")
        #if($rawHighlights != "")
            #foreach($line in $rawHighlights.split("\r?\n"))
                #set($trimmedLine = $line.trim())
                #if($trimmedLine != "" && $highlightsList.size() < 4)
                    #set($dummy4 = $highlightsList.add($trimmedLine))
                #end
            #end
        #end

        ## --- embedUrl: build a native embeddable src (YouTube/Vimeo) so video plays inline
        ## instead of opening a new tab. Falls back to the raw URL for unrecognized hosts. ---
        #set($embedSrc = "")
        #set($rawEmbed = "$!item.embedUrl")
        #if($rawEmbed != "")
            #if($rawEmbed.contains("youtube.com/watch"))
                #set($vIdx = $rawEmbed.indexOf("v="))
                #if($vIdx >= 0)
                    #set($vIdxPlus = $vIdx + 2)
                    #set($vidId = $rawEmbed.substring($vIdxPlus))
                    #set($ampIdx = $vidId.indexOf("&"))
                    #if($ampIdx >= 0)
                        #set($vidId = $vidId.substring(0, $ampIdx))
                    #end
                    #set($embedSrc = "https://www.youtube.com/embed/$vidId")
                #end
            #elseif($rawEmbed.contains("youtu.be/"))
                #set($slashIdx = $rawEmbed.lastIndexOf("/"))
                #set($slashIdxPlus = $slashIdx.intValue() + 1)
                #set($vidId = $rawEmbed.substring($slashIdxPlus))
                #set($embedSrc = "https://www.youtube.com/embed/$vidId")
            #elseif($rawEmbed.contains("vimeo.com/"))
                #set($slashIdx = $rawEmbed.lastIndexOf("/"))
                #set($slashIdxPlus = $slashIdx.intValue() + 1)
                #set($vidId = $rawEmbed.substring($slashIdxPlus))
                #set($embedSrc = "https://player.vimeo.com/video/$vidId")
            #else
                #set($embedSrc = $rawEmbed)
            #end
        #end

        <!-- .ctl-ir-* tag/chip/byline/related-card/hscroll classes now come from the
             shared stylesheet (styles/ctl-widgets.css), loaded via the <link> tag added
             to the sitewide contact-info content block that already renders on every CTL
             page. No local <style> block needed here anymore. -->

        <article style="max-width: 860px;">

            #if("$!item.thumbnail.fileName" != "")
                <img src="$item.thumbnail.path$item.thumbnail.fileName" alt="$item.resourceTitle" style="width: 100%; max-height: 360px; object-fit: cover; border-radius: 8px; margin-bottom: 24px;" />
            #end

            <h2 style="margin-top: 0;">$item.resourceTitle</h2>

            #if(!$frameworksList.isEmpty())
                <div style="margin-bottom: 20px;">
                    #foreach($fw in $frameworksList)
                        <span class="ctl-ir-framework-chip">$fw</span>
                    #end
                </div>
            #end

            #if(!$highlightsList.isEmpty())
                <div class="ctl-ir-highlights">
                    <h3>Need to Know</h3>
                    <ul>
                        #foreach($h in $highlightsList)
                            <li>$h</li>
                        #end
                    </ul>
                </div>
            #end

            #if($bodyHtml != "")
                <div class="ctl-ir-body" style="line-height: 1.7; font-size: 1rem; color: #333; margin-bottom: 28px;">$bodyHtml</div>
            #end

            #if("$!item.videoFile.fileName" != "")
                <div style="margin-bottom: 28px;">
                    <video controls style="width: 100%; border-radius: 8px;" src="$item.videoFile.path$item.videoFile.fileName"></video>
                </div>
            #end
            #if($embedSrc != "")
                <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; margin-bottom: 28px; border-radius: 8px;">
                    <iframe src="$embedSrc" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
            #end

            #if($item.downloadableAttachments && $item.downloadableAttachments.size() > 0)
                <div style="margin-bottom: 32px; border-top: 1px solid var(--ctl-border); padding-top: 20px;">
                    <h3 style="font-size: 1.1rem; margin-bottom: 16px; font-weight: 700;">Downloads</h3>
                    <div style="display: flex; flex-direction: column; gap: 12px; max-width: 500px;">
                        #foreach($file in $item.downloadableAttachments)
                            #if("$!file.ctlAttachmentfile.rawUri" != "")
                                <a href="$file.ctlAttachmentfile.rawUri" target="_blank" rel="noopener" class="btn btn-default" aria-label="Download $file.ctlAttachmentlabel (opens in new tab)" style="display: flex; flex-direction: row; align-items: center; justify-content: flex-start; padding: 0; overflow: hidden; text-align: left; text-transform: uppercase;">
                                    <div style="width: 54px; height: 54px; flex-shrink: 0; background-color: #ffffff !important; color: var(--ctl-maroon) !important; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; border-right: 1px solid currentColor;">
                                        #if("$!file.ctlAttachmentfile.thumbnailUri" != "")
                                            <img src="$file.ctlAttachmentfile.thumbnailUri" alt="" style="width: 100%; height: 100%; object-fit: cover; object-position: top; display: block;" />
                                            <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(138, 42, 43, 0.2); z-index: 2; pointer-events: none;"></div>
                                        #else
                                            <div style="width: 100%; height: 100%; background: #ffffff; display: flex; align-items: center; justify-content: center;">
                                                <i class="bi bi-file-earmark-pdf" style="font-size: 1.25rem; opacity: 0.5;"></i>
                                            </div>
                                        #end
                                    </div>
                                    <div style="display: flex; align-items: center; justify-content: space-between; flex: 1; padding: 0 16px; gap: 12px;">
                                        <span style="font-size: 0.85rem; font-weight: 700; letter-spacing: 0.5px; line-height: 1.2;">$file.ctlAttachmentlabel</span>
                                        <i class="bi bi-download" style="font-size: 0.95rem; font-weight: 700; display: inline-flex; flex-shrink: 0;"></i>
                                    </div>
                                </a>
                            #end
                        #end
                    </div>
                </div>
            #end

            #if($fmtStr != "" || $modStr != "" || "$!item.author" != "" || !$topicsList.isEmpty())
                <div style="margin-bottom: 28px; border-top: 1px solid var(--ctl-border); padding-top: 20px;">
                    #if("$!item.author" != "" || "$!item.lastUpdated" != "")
                        <p class="ctl-ir-byline" style="margin-bottom: 14px;">
                            #if("$!item.author" != "")By $item.author#end
                            #if("$!item.lastUpdated" != "")#if("$!item.author" != "") &middot; #end Updated $date.format('MMMM d, yyyy', $item.lastUpdated)#end
                        </p>
                    #end
                    #if($fmtStr != "" || $modStr != "")
                        <div style="margin-bottom: 14px;">
                            #foreach($f in $fmtStr.split("\|"))
                                #if($f != "")<span class="ctl-ir-tag">$f</span>#end
                            #end
                            #if($modAllSelected)
                                <span class="ctl-ir-modality-tag">All Modalities</span>
                            #else
                                #foreach($m in $modStr.split("\|"))
                                    #if($m != "")<span class="ctl-ir-modality-tag">$m</span>#end
                                #end
                            #end
                        </div>
                    #end
                    #if(!$topicsList.isEmpty())
                        <h3 style="font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--ctl-maroon); margin-bottom: 10px;">Topics</h3>
                        #foreach($tp in $topicsList)
                            <span class="ctl-ir-topic-chip">$tp</span>
                        #end
                    #end
                </div>
            #end

            #if($item.relatedInstructionalResources && $item.relatedInstructionalResources.size() > 0)
                <div style="margin-bottom: 32px; border-top: 1px solid var(--ctl-border); padding-top: 20px;">
                    <h3 style="font-size: 1.1rem; margin-bottom: 16px; font-weight: 700;">Related Resources</h3>
                    <div class="ctl-ir-hscroll">
                        #foreach($rel in $item.relatedInstructionalResources)
                            <div class="ctl-ir-hscroll-item">
                                <div class="card h-100 ctl-ir-related-card ctl-hover-lift">
                                    <div class="card-body">
                                        <h4 class="h6 card-title">
                                            <a href="/centers/ctl/resources/course-design/$!rel.urlTitle" class="stretched-link">$!rel.resourceTitle</a>
                                        </h4>
                                        #if("$!rel.shortDescription" != "")
                                            <p class="card-text small">$rel.shortDescription</p>
                                        #end
                                    </div>
                                </div>
                            </div>
                        #end
                    </div>
                </div>
            #end

            #if($item.relatedEvents && $item.relatedEvents.size() > 0)
                <div style="margin-bottom: 32px; border-top: 1px solid var(--ctl-border); padding-top: 20px;">
                    <h3 style="font-size: 1.1rem; margin-bottom: 16px; font-weight: 700;">Related Events &amp; Opportunities</h3>
                    <ul style="padding-left: 20px;">
                        #foreach($rel in $item.relatedEvents)
                            <li><a href="/centers/ctl/activities/$!rel.urlMapPattern">$!rel.title</a></li>
                        #end
                    </ul>
                </div>
            #end

            #if($citationsHtml != "")
                <div style="margin-bottom: 28px; border-top: 1px solid var(--ctl-border); padding-top: 20px;">
                    <h3 style="font-size: 1.1rem; margin-bottom: 12px; font-weight: 700;">Citations &amp; Further Reading</h3>
                    <div style="font-size: 0.9rem; color: #444; line-height: 1.6;">$citationsHtml</div>
                </div>
            #end

            <p style="margin-top: 40px;">
                <a href="/centers/ctl/resources/course-design" style="color: inherit;">&larr; Back to For Course Design</a>
            </p>

        </article>

    #else
        <div style="padding: 40px; text-align: center; color: var(--ctl-gray-text);">
            <h2>Not Found</h2>
            <p>Sorry, this resource could not be found or may have been removed.</p>
            <a href="/centers/ctl/resources/course-design" style="color: inherit;">Return to For Course Design</a>
        </div>
    #end
#end

#if($matchList.size() > 0)
<script>
document.addEventListener('DOMContentLoaded', function() {
    var titleBanner = document.querySelector('.page-title h1');
    if (titleBanner) {
        titleBanner.textContent = '$item.resourceTitle';
    }
    document.title = '$item.resourceTitle';

    var crumbs = document.querySelectorAll('ol.breadcrumb li.breadcrumb-item');
    if (crumbs.length >= 2) {
        var parentCrumb = crumbs[crumbs.length - 2];
        var activeCrumb = crumbs[crumbs.length - 1];

        var parentLink = parentCrumb.querySelector('a');
        if (parentLink) {
            parentLink.setAttribute('href', '/centers/ctl/resources/course-design');
            parentLink.textContent = 'For Course Design';
        } else {
            parentCrumb.textContent = 'For Course Design';
        }

        activeCrumb.textContent = '$item.resourceTitle';
    }
});
</script>
#end
