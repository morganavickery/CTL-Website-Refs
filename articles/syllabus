<h3 id="course-withdrawal-policy">
<button class="ctl-mission-toggle w-100 d-flex justify-content-between align-items-center text-start" type="button" data-bs-toggle="collapse" data-bs-target="#ctlSyllabusWithdrawal" aria-expanded="false" aria-controls="ctlSyllabusWithdrawal">
